# ─────────────────────────────────────────────────────────────────────────────
# ClipAI — variables de entorno. Copia este archivo a `.env` en la raíz.
# `.env` y `data/` nunca se suben a git.
# Las rutas relativas se resuelven desde la raíz del proyecto.
# ─────────────────────────────────────────────────────────────────────────────

# ── Rutas y servicios (obligatorias) ─────────────────────────────────────────
DATABASE_URL=file:./data/app.db
DATA_DIR=./data
MEDIA_API_URL=http://127.0.0.1:8000
MEDIA_HOST=127.0.0.1
MEDIA_PORT=8000
WEB_PORT=3000

# ── Docker ───────────────────────────────────────────────────────────────────
# `docker compose up` lee este archivo. Estas variables se fijan solas dentro de los
# contenedores y no hace falta tocarlas: DATA_DIR, DATABASE_URL, MEDIA_API_URL, MEDIA_HOST,
# MEDIA_PORT, FFMPEG_BIN, FFPROBE_BIN y YTDLP_COOKIES_FROM_BROWSER. Sí cuentan:
#   WEB_PORT   puerto de la interfaz en tu equipo (por defecto 3000)
#   DATA_PATH  carpeta de datos en tu equipo (por defecto ./data)
#   CLIPAI_UID / CLIPAI_GID  usuario de los contenedores (Linux; por defecto 1000)

# ── IA de selección ──────────────────────────────────────────────────────────
# Sin GEMINI_API_KEY (y sin LLM_BASE_URL) la app funciona con el respaldo sin IA:
# TextTiling + señales (heatmap, audio, gancho), con títulos heurísticos.
GEMINI_API_KEY=
# Gemini en Vertex AI con cuenta de servicio (tiene prioridad sobre GEMINI_API_KEY).
# La cuenta necesita el rol «Vertex AI User». Pon el JSON en un archivo
# (recomendado, p. ej. dentro de data/secrets/, que git ignora) o en línea.
# Los modelos Gemini 3.x solo están en el endpoint `global`: si VERTEX_LOCATION
# es regional, la cadena reintenta ahí sola.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Gemini 3 Flash: más rápido y barato que 2.5 Flash en las pruebas del proyecto.
# En Vertex solo está en el endpoint global (se usa solo).
GEMINI_MODEL=gemini-3-flash-preview
# Si un modelo responde por cuota agotada (429), saturación (503) o retirado (404)
# se prueba el siguiente; cada proyecto nuevo vuelve a empezar por GEMINI_MODEL.
# Nota: con GEMINI_API_KEY de una cuenta nueva, gemini-2.5-flash puede responder 404
# (en Vertex sí está disponible); la cadena sigue entonces con el siguiente modelo.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash,gemini-3.6-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Alternativa local: cualquier servidor compatible con OpenAI (Ollama, LM Studio).
# Si LLM_BASE_URL tiene valor, se usa en lugar de Gemini.
# Ollama: arranca con OLLAMA_CONTEXT_LENGTH=16384 (por defecto usa 4096 y recorta
# sin avisar) y usa un modelo de 7–8B (los de 3B no devuelven JSON fiable).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Embeddings para la segmentación temática (TextTiling con embeddings).
# EMBEDDINGS_ENABLED=0 usa el TextTiling léxico (sin descargar el modelo).
EMBEDDINGS_ENABLED=1
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── Transcripción ────────────────────────────────────────────────────────────
# faster-whisper (CPU/Apple Silicon, probado) | whisperx (GPU NVIDIA, instalar aparte; sin probar)
WHISPER_ENGINE=faster-whisper
# large-v3-turbo + cpu (equilibrado: casi la precisión de large-v3). Con poca RAM (8 GB): small.
# Con GPU NVIDIA: large-v3 + cuda.
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 1 = pulir con Whisper los clips elegidos (recomendado); 0 = quemar los
# subtítulos de YouTube tal cual.
POLISH_WITH_WHISPER=1
# Diarización con pyannote (opcional, solo con WHISPER_ENGINE=whisperx; sin probar).
HF_TOKEN=

# ── Selección de momentos ────────────────────────────────────────────────────
MAX_CLIPS=8
# Duración de cada clip: la decide su historia (gancho → contexto → desarrollo →
# remate), entre CLIP_MIN_SEC y CLIP_MAX_SEC, sin rellenar. 150 s (2:30) es el
# máximo absoluto: un valor mayor se ignora. Los bordes siempre caen en frase o palabra.
CLIP_MIN_SEC=60
CLIP_MAX_SEC=150
# 1 = si el arranque natural es flojo, abrir con un avance de 2–5 s de la frase
# más potente (apertura en frío). Siempre se puede quitar por clip en el estudio.
AUTO_COLD_OPEN=1
PREFILTER_TOP=30
# Renderizar automáticamente los clips elegidos al terminar el análisis.
AUTO_RENDER=1

# ── Hashtags del canal ───────────────────────────────────────────────────────
# Se suman a los hashtags del tema de cada clip (kit y juegos por red), al
# final y sin pasar el tope de cada red. «0» los desactiva.
HASHTAGS_BASE=#YoutubersEspañoles #Streamers
# 1 = añadir delante el hashtag del creador del video original (su canal de
# YouTube, p. ej. #LuisitoComunica). Los videos subidos no tienen canal.
HASHTAGS_CREATOR=1
# Etiqueta del formato que va junto a la del creador (#Clips, #Shorts…). Vacío o 0 = ninguna.
HASHTAGS_FORMAT=#Clips
# Revisión previa: se rechaza el proyecto antes de gastar si no cumple.
MAX_VIDEO_MINUTES=240
MIN_FREE_DISK_GB=3

# ── Render ───────────────────────────────────────────────────────────────────
# Vacío = autodetección (prefiere un ffmpeg con libass, p. ej. ffmpeg-full).
FFMPEG_BIN=
FFPROBE_BIN=
# libx264 | h264_videotoolbox (Mac) | h264_nvenc (NVIDIA)
VIDEO_ENCODER=libx264
X264_CRF=18
X264_PRESET=medium
TARGET_LUFS=-14
# Zoom lento tipo Ken Burns durante el clip (1.0 = desactivado). Se hace sobre el
# cuadro escalado 1,5× (sin saltos) y anclado al tercio superior (la cara).
KEN_BURNS_ZOOM=1.05
# Prioridad baja (nice 0–19) para los ffmpeg del render: si estás editando en el
# estudio mientras renderiza, la interfaz no se traba; sin nada más en marcha el
# render va igual de rápido. 0 = prioridad normal.
RENDER_NICE=10

# ── Subtítulos ──────────────────────────────────────────────────────────────
# Cada proyecto nuevo recibe una plantilla distinta a la de los últimos (todos
# sus clips igual; en el estudio se cambia la de cada clip). Vacío = todas las
# plantillas entran en la rotación; o una lista: hormozi,tiktok,bold-yellow
SUBTITLE_TEMPLATES_AUTO=

# ── Tendencias (página «Tendencias») ────────────────────────────────────────
# Temas que se buscan cuando no escribes nada: los videos más vistos de la
# semana de cada uno, puntuados por su potencial para clips. Separados por comas
# y en el idioma de los videos que quieres (YouTube responde según la búsqueda).
TRENDING_TOPICS=podcast,entrevista,debate,streamer,reacción,humor,historias,noticias
# Idioma hablado de los videos que se muestran (código de 2 letras: es, en, pt…).
# «any» = todos. En la página también se puede cambiar en cada búsqueda.
TRENDING_LANG=es

# ── Reencuadre 9:16 ──────────────────────────────────────────────────────────
# Un solo recorte fijo por escena (cámara quieta).
REFRAME_STATIC_AUTO=1
# Cuánto puede moverse una persona antes de dejar la cámara fija (fracción del cuadro).
REFRAME_MOTION_WIDE_THRESH=0.12
# 1 = si se mueve más, la cámara la sigue con paneo suave; 0 = plano abierto fijo (antes).
REFRAME_FOLLOW=1
# Ventaja que necesita otro hablante para robar el encuadre.
REFRAME_SPEAKER_SWITCH_MARGIN=1.25
# Ignora caras menores a esta fracción de la más grande (público al fondo).
REFRAME_MIN_FACE_RATIO=0.10
# Cuadros (~3 s) antes de volver suavemente al centro si se pierde al sujeto.
REFRAME_LOST_HOLD=90
# Fracción de la distancia al centro que recorre por cuadro pasado ese tiempo (0–1).
REFRAME_LOST_DRIFT=0.05
# Fracción del ancho por debajo de la cual el sujeto cuenta como «centrado» y la cámara no se mueve.
REFRAME_SNAP_CENTER=0.03
# Diálogo entre dos personas con puntajes parecidos: 1 = abrir el plano para que salgan las dos.
REFRAME_DIALOGUE_GROUP=1
REFRAME_DIALOGUE_SCORE_RATIO=0.88
REFRAME_DIALOGUE_SEPARATION=0.28
# Detector de personas de respaldo cuando no hay rostro:
#   none = solo MediaPipe (por defecto, todo MIT/Apache)
#   yolo = YOLOv8 de ultralytics. OJO: es AGPL-3.0; activarlo cambia tus obligaciones de
#          licencia si distribuyes ClipAI. Lee la sección «Licencias» del README.
REFRAME_PERSON_DETECTOR=none
# Diseño SPLIT (dos personas apiladas).
SPLIT_LAYOUT=1
SPLIT_TIGHTNESS=0.8
# 1 = en conversaciones de dos, cortar en seco al que habla en vez de SPLIT.
SPEAKER_CUT=0

# ── Seguridad de la API local ────────────────────────────────────────────────
# La app solo acepta peticiones con Host 127.0.0.1 / localhost / ::1 (y Origin de sus
# propios puertos). Si la abres con otro nombre (p. ej. un túnel o un nombre de tu LAN),
# añádelo aquí, separado por comas. No cambies MEDIA_HOST a 0.0.0.0: no hay login.
ALLOWED_HOSTS=

# ── Descarga (yt-dlp) ────────────────────────────────────────────────────────
# Último recurso si YouTube pide verificación: chrome | firefox | safari | edge
YTDLP_COOKIES_FROM_BROWSER=

# ── Publicación ──────────────────────────────────────────────────────────────
# El kit manual (MP4 + título + descripción + hashtags) está siempre disponible.
# Intermediario opcional Upload-Post (plan gratis: 10 subidas/mes).
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
